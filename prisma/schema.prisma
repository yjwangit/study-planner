generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  plans        StudyPlan[]
}

model StudyPlan {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  deadline    DateTime
  studyDays   String[]
  hoursPerDay Float
  createdAt   DateTime       @default(now())
  subjects    Subject[]
  blocks      ScheduleBlock[]
  suggestions AISuggestion[]
}

model Subject {
  id        String      @id @default(cuid())
  planId    String
  plan      StudyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  name      String
  deadline  DateTime?
  outcomes  Outcome[]
  tasks     Task[]
  resources Resource[]
}

model Outcome {
  id          String             @id @default(cuid())
  subjectId   String
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  description String
  tasks       Task[]
  resources   Resource[]
  questions   PracticeQuestion[]
}

model Task {
  id             String          @id @default(cuid())
  subjectId      String
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  outcomeId      String?
  outcome        Outcome?        @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  title          String
  estimatedHours Float
  status         Status          @default(NOT_STARTED)
  blocks         ScheduleBlock[]
}

model Resource {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  outcomeId String?
  outcome   Outcome? @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  title     String
  type      String
  url       String?
}

model ScheduleBlock {
  id           String    @id @default(cuid())
  planId       String
  plan         StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  date         DateTime
  hours        Float
  status       Status    @default(NOT_STARTED)
  isEditedByUser Boolean  @default(false)
}

model AISuggestion {
  id          String           @id @default(cuid())
  planId      String
  plan        StudyPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  type        String
  content     Json
  assumptions String?
  status      SuggestionStatus @default(PENDING)
  rating      Int?
  correction  String?
  createdAt   DateTime         @default(now())
}

model PracticeQuestion {
  id         String  @id @default(cuid())
  outcomeId  String
  outcome    Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  rating     Int?
  correction String?
}